<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Tests keep warnings-as-errors (Directory.Build.props) but opt out of
         doc-file generation: test method names are the documentation, and
         CS1591 on every [Fact] would demand boilerplate docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BgInference\BgInference\BgInference.csproj" />
    <ProjectReference Include="..\BgTournament.Api\BgTournament.Api.csproj" />
    <ProjectReference Include="..\BgTournament.Core\BgTournament.Core.csproj" />
    <ProjectReference Include="..\BgTournament.EngineClient\BgTournament.EngineClient.csproj" />
    <ProjectReference Include="..\BgTournament.Protocol\BgTournament.Protocol.csproj" />
    <ProjectReference Include="..\BgTournament.ReferenceBot\BgTournament.ReferenceBot.csproj" />
    <ProjectReference Include="..\BgTournament.Server\BgTournament.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
